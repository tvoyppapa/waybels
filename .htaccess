RewriteEngine On
RewriteBase /

# Защита от прямого доступа к файлам конфигурации
<FilesMatch "\.(htaccess|htpasswd|ini|log|sh|sql)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# ====================================
# ЧИСТЫЕ URL ДЛЯ ПРОФИЛЕЙ
# ====================================

# /@username -> profile.php?user=username
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^@([a-zA-Z0-9_]+)$ profile.php?user=$1 [L,QSA]

# Альтернативный вариант без @
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-zA-Z0-9_]+)$ profile.php?user=$1 [L,QSA]

# ====================================
# ОСТАЛЬНЫЕ ПРАВИЛА
# ====================================

# Редирект с index.php на feed.php для авторизованных
# (обрабатывается в самом index.php)

# Принудительный HTTPS (раскомментировать при необходимости)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Убираем trailing slash
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} (.+)/$
RewriteRule ^ %1 [R=301,L]
